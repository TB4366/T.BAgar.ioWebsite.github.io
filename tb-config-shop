  res.send(`<h2>Return from Xsolla</h2>
    <div>Query parameters: <pre>${escapeHtml(JSON.stringify(req.query,null,2))}</pre></div>
    <div>If webhook is configured you should see server log entries and the game-backend grant.</div>`);
});

function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// Webhook endpoint:
// We'll accept raw body so we can optionally verify HMAC signature.
app.post('/webhook/xsolla', express.raw({type: '*/*', limit:'1mb'}), async (req, res) => {
  try {
    const raw = req.body; // Buffer
    let body = {};
    try { body = JSON.parse(raw.toString('utf8')); } catch(e){ body = {}; }

    // Optional signature verification if XSOLLA_SECRET set
    if (XSOLLA_SECRET) {
      const sig = req.get('X-Signature') || req.get('x-xsolla-signature') || req.get('x-signature');
      if (!sig) {
        console.warn('No signature header present');
        // continue but in prod you may want to reject
      } else {
        const computed = crypto.createHmac('sha256', XSOLLA_SECRET).update(raw).digest('hex');
        if (computed !== sig) {
          console.warn('Invalid signature: computed', computed, 'received', sig);
          return res.status(400).send('invalid signature');
        }
      }
    }

    // Try to find agario_uid in common places (custom parameters / additional base64 / query)
    let agarioUid = body.agario_uid || null;
    if (!agarioUid && body.custom_parameters && body.custom_parameters.agario_uid) agarioUid = body.custom_parameters.agario_uid;
    if (!agarioUid && body.additional) {
      try {
        const decoded = Buffer.from(String(body.additional), 'base64').toString('utf8');
        const parsed = JSON.parse(decoded);
        if (parsed && parsed.agario_uid) agarioUid = parsed.agario_uid;
      } catch(e){}
    }
    // transaction id / status - adapt depending on Xsolla payload
    const txId = (body.transaction && (body.transaction.id || body.transaction.txn_id)) || body.id || body.transaction_id || null;
    const status = (body.status || (body.transaction && body.transaction.status) || '').toString().toLowerCase();

    console.log('Webhook received: txId=', txId, 'status=', status, 'agario_uid=', agarioUid);

    const finalStates = ['charged','completed','succeeded','captured'];
    if (!finalStates.includes(status)) {
      console.log('Non-final status, ignoring for now');
      return res.status(200).send('ignored');
    }
    if (!agarioUid) {
      console.warn('agario_uid missing in webhook. Save payload for manual reconciliation and respond 400');
      return res.status(400).send('missing agario_uid');
    }
    if (!txId) {
      console.warn('txId missing');
    }

    // idempotency
    if (txId && processedTx.has(txId)) {
      console.log('Transaction already processed', txId);
      return res.status(200).send('already_processed');
    }

    // Determine productId (try several fields)
    let productId = (body.purchase && body.purchase.sku) || (body.item && body.item.sku) || (body.custom_parameters && body.custom_parameters.tb_ref_product) || null;
    if (!productId && body.additional) {
      try {
        const parsed = JSON.parse(Buffer.from(String(body.additional),'base64').toString('utf8'));
        if (parsed && parsed.tb_ref_product) productId = parsed.tb_ref_product;
      } catch(e){}
    }

    // Call game backend to grant the skin (if configured)
    if (GAME_BACKEND_URL) {
      const payload = { uid: agarioUid, productId, transactionId: txId, source: 'xsolla' };
      try {
        const resp = await fetch(GAME_BACKEND_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(GAME_BACKEND_KEY ? { 'Authorization': 'Bearer ' + GAME_BACKEND_KEY } : {}) },
          body: JSON.stringify(payload),
          timeout: 10000
        });
        if (!resp.ok) {
          const text = await resp.text();
          console.error('Grant call failed', resp.status, text);
          return res.status(500).send('grant_failed');
        }
      } catch(err) {
        console.error('Grant call error', err);
        return res.status(500).send('grant_error');
      }
    } else {
      console.log('GAME_BACKEND_URL not set - skipping grant. Payload would be:', { uid: agarioUid, productId, transactionId: txId});
    }

    // mark processed
    if (txId) processedTx.add(txId);

    return res.status(200).send('ok');
  } catch(err) {
    console.error('Webhook processing failed', err);
    return res.status(500).send('error');
  }
});

