<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Deals Slider</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }

    /* Overlay achtergrond */
    .overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    /* Slider container */
    .slider {
      background: #fff;
      width: 80%;
      max-width: 600px;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }

    /* Dia's */
    .slide {
      display: none;
      text-align: center;
      padding: 20px;
    }

    .slide img {
      width: 100%;
      border-radius: 8px;
    }

    /* Navigatie knoppen */
    .prev, .next {
      cursor: pointer;
      position: absolute;
      top: 50%;
      padding: 12px;
      color: white;
      font-weight: bold;
      font-size: 20px;
      border-radius: 50%;
      background: rgba(0,0,0,0.5);
      transform: translateY(-50%);
      user-select: none;
    }
    .prev { left: 10px; }
    .next { right: 10px; }

    /* Sluitknop */
    .close-btn {
      position: absolute;
      top: 10px;
      right: 15px;
      font-size: 28px;
      font-weight: bold;
      cursor: pointer;
      color: #333;
    }

    /* Timer */
    .countdown {
      margin-top: 10px;
      font-size: 18px;
      font-weight: bold;
      color: #e63946;
    }

    /* Knop op website om menu te openen */
    .open-deals {
      margin: 20px;
      padding: 10px 20px;
      background: #0077cc;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <!-- Knop om menu te openen -->
  <button class="open-deals">Bekijk Deals</button>

  <!-- Overlay met slider -->
  <div class="overlay" id="overlay">
    <div class="slider">
      <span class="close-btn" onclick="closeOverlay()">&times;</span>

      <!-- Slide 1 -->
      <div class="slide">
        <h2>Deal 1</h2>
        <img src="A4D1FB96-C186-489C-80C4-747C3DB57BC2.jpeg" alt="Deal 1">
        <p class="countdown" data-time="20"></p>
      </div>

      <!-- Slide 2 -->
      <div class="slide">
        <h2>Deal 2</h2>
        <img src="https://via.placeholder.com/500x250?text=Deal+2" alt="Deal 2">
        <p class="countdown" data-time="15"></p>
      </div>

      <!-- Slide 3 -->
      <div class="slide">
        <h2>Nieuws</h2>
        <img src="https://via.placeholder.com/500x250?text=Nieuws" alt="Nieuws">
        <p class="countdown" data-time="10"></p>
      </div>

      <!-- Navigatie -->
      <a class="prev" onclick="changeSlide(-1)">&#10094;</a>
      <a class="next" onclick="changeSlide(1)">&#10095;</a>
    </div>
  </div>

  <script>
    let slideIndex = 0;
    let slides = document.querySelectorAll(".slide");
    let timers = [];

    function showSlide(n) {
      // Stop eerdere timers
      timers.forEach(t => clearInterval(t));
      timers = [];

      if (n >= slides.length) slideIndex = 0;
      if (n < 0) slideIndex = slides.length - 1;

      slides.forEach(s => s.style.display = "none");
      slides[slideIndex].style.display = "block";

      // Countdown per slide
      let countdownElem = slides[slideIndex].querySelector(".countdown");
      let timeLeft = parseInt(countdownElem.dataset.time);

      countdownElem.textContent = "Nog " + timeLeft + " sec";
      let timer = setInterval(() => {
        timeLeft--;
        if (timeLeft > 0) {
          countdownElem.textContent = "Nog " + timeLeft + " sec";
        } else {
          clearInterval(timer);
          changeSlide(1);
        }
      }, 1000);
      timers.push(timer);
    }

    function changeSlide(n) {
      slideIndex += n;
      showSlide(slideIndex);
    }

    function closeOverlay() {
      document.getElementById("overlay").style.display = "none";
    }

    function openOverlay() {
      document.getElementById("overlay").style.display = "flex";
      slideIndex = 0;
      showSlide(slideIndex);
    }

    document.querySelector(".open-deals").addEventListener("click", openOverlay);

    // Automatisch openen bij laden van site
    window.onload = openOverlay;
  </script>

</body>
</html>
